digraph DFA {
  rankdir=LR;
  bgcolor="white";
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="#FFFFFF", color="#1F3A5F", fontcolor="#12263A"];
  edge [fontname="Helvetica", fontsize=10, color="#5B6B7C", fontcolor="#33475B"];
  nstart [shape=point, width=0.12, color="#1F3A5F"];
  n0 [label="q0", shape=circle];
  n1 [label="q1", shape=circle];
  n2 [label="q2", shape=circle];
  n3 [label="q3", shape=circle];
  n4 [label="q4", shape=circle];
  n5 [label="q5", shape=circle];
  n6 [label="q6", shape=circle];
  n7 [label="q7", shape=circle];
  n8 [label="q8", shape=doublecircle];
  n9 [label="q9", shape=circle];
  n10 [label="q10", shape=circle];
  n11 [label="qd", shape=circle, style="filled,dashed", fontcolor="#7A8794"];
  nstart -> n0;
  n0 -> n1 [label="letter, digit"];
  n0 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n1 -> n1 [label="letter, digit"];
  n1 -> n2 [label="., -, _"];
  n1 -> n3 [label="@"];
  n1 -> n11 [label="other", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n2 -> n1 [label="letter, digit"];
  n2 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n3 -> n4 [label="letter, digit"];
  n3 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n4 -> n4 [label="letter, digit"];
  n4 -> n6 [label="."];
  n4 -> n5 [label="-"];
  n4 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n5 -> n4 [label="letter, digit"];
  n5 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n6 -> n7 [label="letter"];
  n6 -> n9 [label="digit"];
  n6 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n7 -> n8 [label="letter"];
  n7 -> n9 [label="digit"];
  n7 -> n6 [label="."];
  n7 -> n10 [label="-"];
  n7 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n8 -> n8 [label="letter"];
  n8 -> n9 [label="digit"];
  n8 -> n6 [label="."];
  n8 -> n10 [label="-"];
  n8 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n9 -> n9 [label="letter, digit"];
  n9 -> n6 [label="."];
  n9 -> n10 [label="-"];
  n9 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n10 -> n9 [label="letter, digit"];
  n10 -> n11 [label="else", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
  n11 -> n11 [label="Σ", style=dashed, color="#A8B3BF", fontcolor="#7A8794"];
}