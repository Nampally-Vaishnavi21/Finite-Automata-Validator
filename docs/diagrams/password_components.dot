digraph DFA {
  rankdir=LR; compound=true; nodesep=0.35;
  bgcolor="white";
  node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="#FFFFFF", color="#1F3A5F", fontcolor="#12263A"];
  edge [fontname="Helvetica", fontsize=10, color="#5B6B7C", fontcolor="#33475B"];
  subgraph cluster_0 {
    label="Length ≥ 8"; fontname="Helvetica"; fontsize=11; color="#CBD5E1"; style="rounded"; fontcolor="#33475B";
    c0_start [shape=point, width=0.12, color="#1F3A5F"];
    c0_0 [label="0", shape=circle];
    c0_1 [label="1", shape=circle];
    c0_2 [label="2", shape=circle];
    c0_3 [label="3", shape=circle];
    c0_4 [label="4", shape=circle];
    c0_5 [label="5", shape=circle];
    c0_6 [label="6", shape=circle];
    c0_7 [label="7", shape=circle];
    c0_8 [label="8+", shape=doublecircle];
    c0_start -> c0_0;
    c0_0 -> c0_1 [label="Σ"];
    c0_1 -> c0_2 [label="Σ"];
    c0_2 -> c0_3 [label="Σ"];
    c0_3 -> c0_4 [label="Σ"];
    c0_4 -> c0_5 [label="Σ"];
    c0_5 -> c0_6 [label="Σ"];
    c0_6 -> c0_7 [label="Σ"];
    c0_7 -> c0_8 [label="Σ"];
    c0_8 -> c0_8 [label="Σ"];
  }
  subgraph cluster_1 {
    label="Has uppercase letter"; fontname="Helvetica"; fontsize=11; color="#CBD5E1"; style="rounded"; fontcolor="#33475B";
    c1_start [shape=point, width=0.12, color="#1F3A5F"];
    c1_0 [label="not yet", shape=circle];
    c1_1 [label="seen", shape=doublecircle];
    c1_start -> c1_0;
    c1_0 -> c1_1 [label="A-Z"];
    c1_0 -> c1_0 [label="a-z, 0-9, special"];
    c1_1 -> c1_1 [label="Σ"];
  }
  subgraph cluster_2 {
    label="Has lowercase letter"; fontname="Helvetica"; fontsize=11; color="#CBD5E1"; style="rounded"; fontcolor="#33475B";
    c2_start [shape=point, width=0.12, color="#1F3A5F"];
    c2_0 [label="not yet", shape=circle];
    c2_1 [label="seen", shape=doublecircle];
    c2_start -> c2_0;
    c2_0 -> c2_0 [label="A-Z, 0-9, special"];
    c2_0 -> c2_1 [label="a-z"];
    c2_1 -> c2_1 [label="Σ"];
  }
  subgraph cluster_3 {
    label="Has digit"; fontname="Helvetica"; fontsize=11; color="#CBD5E1"; style="rounded"; fontcolor="#33475B";
    c3_start [shape=point, width=0.12, color="#1F3A5F"];
    c3_0 [label="not yet", shape=circle];
    c3_1 [label="seen", shape=doublecircle];
    c3_start -> c3_0;
    c3_0 -> c3_0 [label="A-Z, a-z, special"];
    c3_0 -> c3_1 [label="0-9"];
    c3_1 -> c3_1 [label="Σ"];
  }
  subgraph cluster_4 {
    label="Has special character"; fontname="Helvetica"; fontsize=11; color="#CBD5E1"; style="rounded"; fontcolor="#33475B";
    c4_start [shape=point, width=0.12, color="#1F3A5F"];
    c4_0 [label="not yet", shape=circle];
    c4_1 [label="seen", shape=doublecircle];
    c4_start -> c4_0;
    c4_0 -> c4_0 [label="A-Z, a-z, 0-9"];
    c4_0 -> c4_1 [label="special"];
    c4_1 -> c4_1 [label="Σ"];
  }
}