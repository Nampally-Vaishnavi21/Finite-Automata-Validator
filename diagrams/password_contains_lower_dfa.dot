digraph G { rankdir=LR; bgcolor="white"; pad=0.2; label="contains lower"; labelloc=t; fontname="Helvetica"; fontsize=12; node [fontname="Helvetica", fontsize=11, style=filled, fillcolor="#F4F7FB", color="#1F3A5F"]; edge [fontname="Helvetica", fontsize=10, color="#5B6B7F", arrowsize=0.7]; s [shape=point, width=0.12]; no [label="no", shape=circle]; yes [label="yes", shape=doublecircle]; s -> no; no -> no [label="upper, digit, special"]; no -> yes [label="lower"]; yes -> yes [label="any"]; }